# Lanth Wear backend — environment configuration
#
# Copy this file to .env and fill in your real values. .env is gitignored.
# NEVER put real secrets in this file.

# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DB=lanth

# Server
PORT=3002

# Shop owner admin key. Must be sent as the X-Admin-Key header
# on product create/update/delete, tracking update and image upload requests.
ADMIN_API_KEY=change-me

# Paystack secret key (sk_...) for your live/test account.
# Sign up at https://dashboard.paystack.com and copy from Settings > API Keys.
PAYSTACK_SECRET_KEY=
# Where Paystack redirects the customer after payment, e.g. https://yourshop.com/order/complete
PAYSTACK_CALLBACK_URL=

# Resend email (https://resend.com) — used for payment/backorder/tracking emails.
# The "from" address must be from a verified domain in Resend.
RESEND_API_KEY=
EMAIL_FROM=Lanth Wear <onboarding@resend.dev>

# Cloudinary (https://cloudinary.com) — image uploads for product photos.
# Find these under Dashboard > Account Settings and Dashboard > API Keys.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_KEY=
CLOUDINARY_SECRET=

# NOTE ON PRICES
# All amounts are in kobo (the smallest unit of Naira). Paystack charges in
# kobo, so the API accepts/returns integer kobo:
#   price 50000  == ₦500.00
#   price 150000 == ₦1,500.00
# Multiply Naira by 100 when creating products or displaying totals.

# COLLECTIONS
# Collections live in the MongoDB `collections` collection and are managed by
# the shop owner (admin endpoints). They are hierarchical — a collection can
# have a parent_id, so you can nest arbitrarily, e.g. shoes > sneakers > running.
# Products are created under a collection (collection_id or its slug) and
# inherit the full path. Seeded defaults on first start:
#   watches > active-trackers
#   shoes   > sneakers
#   clothing > shirts
#   jerseys
